[Unit]
Description=ETF Tracker API Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/user/n8n-self-hosted/openclaw-skills/etf-tracker/scripts
EnvironmentFile=/etc/etf-tracker.env
ExecStart=/usr/bin/python3 /home/user/n8n-self-hosted/openclaw-skills/etf-tracker/scripts/api_server.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
