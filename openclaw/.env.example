# =============================================================================
# OpenClaw Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
# =============================================================================

# --- Required ---

# Gateway authentication token (auto-generated during install, or set manually)
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# --- AI Provider API Keys (at least one required) ---

# Anthropic Claude API Key (recommended)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key (optional alternative)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Optional Configuration ---

# Docker image to use (default: openclaw:local for self-built)
# OPENCLAW_IMAGE=openclaw:local

# Gateway port (default: 18789)
# OPENCLAW_GATEWAY_PORT=18789

# Bridge port (default: 18790)
# OPENCLAW_BRIDGE_PORT=18790

# Extra apt packages to install during Docker build (space-separated)
# Example: "ffmpeg build-essential"
# OPENCLAW_DOCKER_APT_PACKAGES=

# Extra host directories to mount into container (comma-separated Docker bind mount syntax)
# Example: "/home/user/data:/home/node/data:ro"
# OPENCLAW_EXTRA_MOUNTS=

# Named Docker volume for persisting /home/node across container recreations
# OPENCLAW_HOME_VOLUME=openclaw_home

# Docker socket GID for container docker access (find with: stat -c %g /var/run/docker.sock)
# DOCKER_GID=999
