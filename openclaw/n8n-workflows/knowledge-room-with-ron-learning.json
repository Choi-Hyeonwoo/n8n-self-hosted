    {
      "parameters": {
        "jsCode": "// RON 학습을 위한 데이터 생성\nconst prefixData = $('파일명 prefix 생성').item.json;\n\n// 업로드된 파일 정보 수집\nlet uploadedFiles = [];\n\ntry {\n  const textResult = $('Drive 텍스트 업로드').first();\n  if (textResult) uploadedFiles.push({type: 'text', id: textResult.json.id, name: textResult.json.name});\n} catch(e) {}\n\ntry {\n  const photoResult = $('Drive 사진 업로드').first();\n  if (photoResult) uploadedFiles.push({type: 'photo', id: photoResult.json.id, name: photoResult.json.name});\n} catch(e) {}\n\ntry {\n  const docResult = $('Drive 문서 업로드').first();\n  if (docResult) uploadedFiles.push({type: 'document', id: docResult.json.id, name: docResult.json.name});\n} catch(e) {}\n\ntry {\n  const videoResult = $('Drive 동영상 업로드').first();\n  if (videoResult) uploadedFiles.push({type: 'video', id: videoResult.json.id, name: videoResult.json.name});\n} catch(e) {}\n\nreturn {\n  json: {\n    action: 'learn',\n    source: '지식사랑방',\n    topic: prefixData.topicName,\n    threadId: prefixData.threadId,\n    folderId: prefixData.targetFolderId,\n    timestamp: prefixData.timestamp,\n    content: prefixData.textContent.substring(0, 500),\n    files: uploadedFiles,\n    title: prefixData.topic\n  }\n};"
      },
