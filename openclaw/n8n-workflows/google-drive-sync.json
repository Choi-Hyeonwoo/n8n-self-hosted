{
  "name": "OpenClaw Knowledge → Google Drive Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 3
            },
            {
              "triggerAtHour": 15
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Sync Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "knowledge-sync",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Manual Trigger Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 550]
    },
    {
      "parameters": {
        "url": "=https://mangd.app.n8n.cloud/webhook/knowledge-sync",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"source\": \"schedule\", \"timestamp\": \"{{ $now.toISO() }}\"}"
      },
      "id": "dummy-pass",
      "name": "Pass Through",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [250, 400]
    },
    {
      "parameters": {
        "jsCode": "// Configure your VPS SSH connection details\n// This node generates the list of changed files from the VPS knowledge repo\n\nconst config = {\n  knowledgePath: '/home/openclaw/.openclaw/workspace/knowledge',\n  // Google Drive folder ID where vault is stored\n  googleDriveFolderId: '{{GOOGLE_DRIVE_FOLDER_ID}}',\n  // Vault folder structure mapping\n  folders: [\n    '00-MOC',\n    '01-Concepts',\n    '02-Entities',\n    '03-Notes/tech',\n    '03-Notes/finance',\n    '03-Notes/business',\n    '03-Notes/devops',\n    '03-Notes/n8n',\n    '04-Daily',\n    '05-Weekly',\n    '06-Projects',\n    '07-Reference',\n    'templates'\n  ]\n};\n\n// Pass config to next nodes\nreturn [{\n  json: {\n    config,\n    syncType: $input.first().json.source || 'manual',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "sync-config",
      "name": "Sync Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 400]
    },
    {
      "parameters": {
        "command": "=cd /home/openclaw/.openclaw/workspace/knowledge && git log --diff-filter=ACMR --name-only --pretty=format:'' -1 HEAD | grep '.md$' | head -50"
      },
      "id": "get-changed-files",
      "name": "Get Changed Files (SSH)",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {
        "sshPassword": {
          "id": "{{SSH_CREDENTIAL_ID}}",
          "name": "VPS SSH"
        }
      }
    },
    {
      "parameters": {
        "command": "=cd /home/openclaw/.openclaw/workspace/knowledge && find . -name '*.md' -newer /tmp/last-gdrive-sync 2>/dev/null | sed 's|^\\./||' | head -100; touch /tmp/last-gdrive-sync"
      },
      "id": "get-modified-files",
      "name": "Get Modified Files (SSH)",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [650, 500],
      "credentials": {
        "sshPassword": {
          "id": "{{SSH_CREDENTIAL_ID}}",
          "name": "VPS SSH"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Combine and deduplicate file lists from both methods\nconst gitFiles = ($('Get Changed Files (SSH)').first().json.stdout || '').split('\\n').filter(f => f.trim());\nconst modifiedFiles = ($('Get Modified Files (SSH)').first().json.stdout || '').split('\\n').filter(f => f.trim());\n\nconst allFiles = [...new Set([...gitFiles, ...modifiedFiles])].filter(f => f.endsWith('.md'));\n\nif (allFiles.length === 0) {\n  return [{ json: { status: 'no_changes', message: 'No files to sync', count: 0 } }];\n}\n\n// Return each file as a separate item for parallel processing\nreturn allFiles.map(filePath => ({\n  json: {\n    filePath,\n    folder: filePath.split('/').slice(0, -1).join('/'),\n    fileName: filePath.split('/').pop(),\n    fullPath: `/home/openclaw/.openclaw/workspace/knowledge/${filePath}`\n  }\n}));"
      },
      "id": "merge-file-lists",
      "name": "Merge & Deduplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-has-files",
              "leftValue": "={{ $json.status }}",
              "rightValue": "no_changes",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "has-changes",
      "name": "Has Changes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 400]
    },
    {
      "parameters": {
        "command": "=cat {{ $json.fullPath }}"
      },
      "id": "read-file-content",
      "name": "Read File Content (SSH)",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [1300, 300],
      "credentials": {
        "sshPassword": {
          "id": "{{SSH_CREDENTIAL_ID}}",
          "name": "VPS SSH"
        }
      }
    },
    {
      "parameters": {
        "name": "={{ $('Merge & Deduplicate').item.json.fileName }}",
        "driveId": "My Drive",
        "folderId": "={{ $('Sync Config').first().json.config.googleDriveFolderId }}",
        "options": {
          "updateIfExists": true
        }
      },
      "id": "upload-to-gdrive",
      "name": "Upload to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1500, 300],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "{{GDRIVE_CREDENTIAL_ID}}",
          "name": "Google Drive"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Build sync summary report\nconst items = $input.all();\nconst syncedCount = items.length;\nconst now = new Date().toLocaleString('ko-KR', {timeZone: 'Asia/Seoul'});\n\nconst fileList = items.map(item => {\n  const name = item.json.name || item.json.fileName || 'unknown';\n  return `  • ${name}`;\n}).join('\\n');\n\nconst report = `📁 Knowledge Sync Report\\n` +\n  `━━━━━━━━━━━━━━━━━━━━━━━━\\n` +\n  `시간: ${now}\\n` +\n  `동기화 파일: ${syncedCount}건\\n\\n` +\n  `파일 목록:\\n${fileList}\\n\\n` +\n  `✅ Google Drive 동기화 완료`;\n\nreturn [{ json: { report, syncedCount, timestamp: now } }];"
      },
      "id": "build-sync-report",
      "name": "Build Sync Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot8423138757:AAGiCfdo5Mwhn68sURNB--e9W-LsrM_WFCU/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: '492860021', text: $json.report }) }}"
      },
      "id": "telegram-notify",
      "name": "Notify Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1900, 300]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { status: 'skipped', message: 'No changes detected, sync skipped' } }];"
      },
      "id": "no-changes",
      "name": "No Changes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 550]
    }
  ],
  "connections": {
    "Sync Schedule": {
      "main": [
        [{"node": "Pass Through", "type": "main", "index": 0}]
      ]
    },
    "Manual Trigger Webhook": {
      "main": [
        [{"node": "Pass Through", "type": "main", "index": 0}]
      ]
    },
    "Pass Through": {
      "main": [
        [{"node": "Sync Config", "type": "main", "index": 0}]
      ]
    },
    "Sync Config": {
      "main": [
        [
          {"node": "Get Changed Files (SSH)", "type": "main", "index": 0},
          {"node": "Get Modified Files (SSH)", "type": "main", "index": 0}
        ]
      ]
    },
    "Get Changed Files (SSH)": {
      "main": [
        [{"node": "Merge & Deduplicate", "type": "main", "index": 0}]
      ]
    },
    "Get Modified Files (SSH)": {
      "main": [
        [{"node": "Merge & Deduplicate", "type": "main", "index": 0}]
      ]
    },
    "Merge & Deduplicate": {
      "main": [
        [{"node": "Has Changes?", "type": "main", "index": 0}]
      ]
    },
    "Has Changes?": {
      "main": [
        [{"node": "Read File Content (SSH)", "type": "main", "index": 0}],
        [{"node": "No Changes", "type": "main", "index": 0}]
      ]
    },
    "Read File Content (SSH)": {
      "main": [
        [{"node": "Upload to Google Drive", "type": "main", "index": 0}]
      ]
    },
    "Upload to Google Drive": {
      "main": [
        [{"node": "Build Sync Report", "type": "main", "index": 0}]
      ]
    },
    "Build Sync Report": {
      "main": [
        [{"node": "Notify Telegram", "type": "main", "index": 0}]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Seoul"
  },
  "tags": [
    {"name": "openclaw"},
    {"name": "sync"},
    {"name": "google-drive"}
  ]
}
