    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const stdout = $input.first().json.stdout || '';\nfunction extract(text, s, e) {\n  const si = text.indexOf(s);\n  const ei = text.indexOf(e);\n  if (si === -1 || ei === -1) return 'N/A';\n  return text.slice(si + s.length, ei).trim();\n}\nconst disk = extract(stdout, 'DISK_START', 'DISK_END');\nconst mem = extract(stdout, 'MEM_START', 'MEM_END');\nconst cpu = extract(stdout, 'CPU_START', 'CPU_END');\nconst docker = extract(stdout, 'DOCKER_START', 'DOCKER_END');\nconst mcp = extract(stdout, 'MCP_START', 'MCP_END');\nconst load = extract(stdout, 'LOAD_START', 'LOAD_END');\nconst diskMatch = disk.match(/(\\d+)%/);\nconst diskPct = diskMatch ? parseInt(diskMatch[1]) : 0;\nconst memLines = mem.split('\\n');\nconst memLine = memLines.find(l => l.includes('Mem:'));\nlet memPct = 0;\nif (memLine) {\n  const p = memLine.trim().split(/\\s+/);\n  const t = parseFloat(p[1]); const u = parseFloat(p[2]);\n  if (t > 0) memPct = (u / t) * 100;\n}\nconst cpuMatch = cpu.match(/(\\d+\\.?\\d*)\\s*us/);\nconst cpuPct = cpuMatch ? parseFloat(cpuMatch[1]) : 0;\nlet status = '\\u2705'; let alerts = [];\nif (diskPct > 80) { status = '\\ud83d\\udd34'; alerts.push('\\ub514\\uc2a4\\ud06c ' + diskPct + '%'); }\nelse if (diskPct > 60) { status = '\\ud83d\\udfe1'; alerts.push('\\ub514\\uc2a4\\ud06c ' + diskPct + '%'); }\nif (memPct > 85) { status = '\\ud83d\\udd34'; alerts.push('\\uba54\\ubaa8\\ub9ac ' + memPct.toFixed(1) + '%'); }\nelse if (memPct > 70) { if (status !== '\\ud83d\\udd34') status = '\\ud83d\\udfe1'; alerts.push('\\uba54\\ubaa8\\ub9ac ' + memPct.toFixed(1) + '%'); }\nconst alertText = alerts.length > 0 ? '\\n\\u26a0\\ufe0f ' + alerts.join(', ') : '';\nconst msg = status + ' VPS \\uc0c1\\ud0dc \\ub9ac\\ud3ec\\ud2b8' + alertText + '\\n\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\u2501\\n\\ud83d\\udcbe \\ub514\\uc2a4\\ud06c: ' + diskPct + '% \\uc0ac\\uc6a9\\n\\ud83e\\udde0 \\uba54\\ubaa8\\ub9ac: ' + memPct.toFixed(1) + '% \\uc0ac\\uc6a9\\n\\u26a1 CPU: ' + cpuPct.toFixed(1) + '%\\n\\ud83d\\udcca \\ub85c\\ub4dc: ' + load + '\\n\\n\\ud83d\\udc33 Docker:\\n' + docker + '\\n\\n\\ud83d\\udd0c MCP \\uc11c\\ubc84:\\n' + mcp;\nconst shouldNotify = alerts.length > 0 || $('수동 트리거').isExecuted;\nreturn [{ json: { message: msg, status, diskPct, memPct: Math.round(memPct*10)/10, cpuPct, alerts, shouldNotify } }];"
      },
      "id": "code1",
      "name": "상태 리포트 생성",
